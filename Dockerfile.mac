# Мухолет — образ linux/arm64: нативный запуск на Apple Silicon (без Rosetta).
# Отличия от Dockerfile: платформа и установка зависимостей из сети — скачанные
# wheels/ под manylinux_aarch64 отсутствуют, а фронт берётся готовым из web/dist
# (его собирает `npm run build` до docker build).
# Сборка:  docker build --platform linux/arm64 -f Dockerfile.mac -t muholet:mac .
# Запуск:   docker run --rm -p 8080:8080 -v "$PWD/data:/app/data" muholet:mac

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
RUN python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir \
        fastapi "uvicorn[standard]" numpy "pydantic>=2" websockets
ENV PATH="/venv/bin:$PATH"
RUN mkdir -p data
COPY navedenie/ navedenie/
COPY data/ data/
COPY web/dist/ web/dist/
EXPOSE 8080
CMD ["uvicorn", "navedenie.app:app", "--host", "0.0.0.0", "--port", "8080"]
